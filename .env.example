# Set these in Vercel Settings > Environment Variables. Never commit values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Production reference is shared across scopes. Preview reference is Preview only.
SUPABASE_PRODUCTION_PROJECT_REF=
SUPABASE_PREVIEW_PROJECT_REF=
# Comma-separated Supabase Auth user UUIDs, server-side only.
OPERATIONS_OWNER_IDS=
# Required to process background jobs, not to browse saved projects.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Optional generation providers. These remain server-side.
OPENAI_API_KEY=
RUNWAYML_API_SECRET=
ELEVENLABS_API_KEY=
VISUAL_INFERENCE_URL=
VISUAL_INFERENCE_TOKEN=
